{
  "name": "devmatch",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm --filter @devmatch/web build",
    "start": "pnpm --filter @devmatch/api start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @devmatch/api db:generate",
    "db:migrate": "pnpm --filter @devmatch/api db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
